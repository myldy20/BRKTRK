  "parameters": {
    "count": 8,
    "parameterSchemaVersion": 1,
    "numericIdsFrozen": true,
    "stableKeysFrozen": true,
    "registry": "parameter-registry.json",
    "sourceOfTruth": "include/brk_bogie/parameter_registry.hpp",
    "ids": {
      "model": 256,
      "decay": 257,
      "tone": 258,
      "sweep": 259,
      "noise": 260,
      "fm": 261,
      "drive": 512,
      "level": 513
    },
    "genericModulationDestinations": ["decay","tone","sweep","noise","fm","drive","level"]
  },
  "state": {
    "schemaVersion": 65536,
    "schemaMajor": 1,
    "schemaMinor": 0,
    "byteSize": 120,
    "parameterRecords": 8,
    "crc32": true,
    "atomicRestore": true,
    "stoppedOnlyIo": true,
    "sourceOfTruth": "include/brk_bogie/state_v1.hpp"
  },
  "runtime": {
    "maxPolyphony": 8,
    "maxModuleInstances": 8,
    "fixedVoicePool": true,
    "processHeapAllocation": false,
    "deterministicSeed": true,
    "wasmInitialMemoryBytes": 4194304,
    "wasmMaximumMemoryBytes": 4194304,
    "memoryGrowth": false,
    "engineSpecificAudioWorklet": false,
    "audioWorkletOwnership": "generic-brksynth-host",
